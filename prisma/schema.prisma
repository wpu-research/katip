// Kâtip - Prisma Schema
// Hukuk bürosu AI sistemi veritabanı şeması
// Postgres 17 + pgvector + pg_trgm gerektirir

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum SensitivityLevel {
  L1_NORMAL
  L2_SENSITIVE
  L3_HIGHLY_CONFIDENTIAL
}

enum CaseType {
  COMMERCIAL
  CRIMINAL
  FAMILY
  LABOR
  ADMINISTRATIVE
  ENFORCEMENT
  BANKRUPTCY
  INTELLECTUAL_PROPERTY
  OTHER
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  WAITING_HEARING
  WAITING_DECISION
  CLOSED
  ARCHIVED
}

enum PartyRole {
  PLAINTIFF
  DEFENDANT
  INTERVENOR
  THIRD_PARTY
  WITNESS
  EXPERT
}

enum DocumentType {
  PETITION
  CONTRACT
  EVIDENCE
  COURT_DECISION
  NOTIFICATION
  CORRESPONDENCE
  INVOICE
  TIME_ENTRY
  OTHER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  NEEDS_REVIEW
  APPROVED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum ConflictCheckStatus {
  CLEAR
  POTENTIAL_CONFLICT
  CONFIRMED_CONFLICT
  NEEDS_MANUAL_REVIEW
}

enum BillingType {
  HOURLY
  FIXED_FEE
  CONTINGENCY
  RETAINER
  SUCCESS_FEE
}

// ============================================
// CORE MODELS
// ============================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  role          String    // "lawyer", "intern", "secretary", "admin"
  department    String?
  avatarUrl     String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cases         CaseLawyer[]
  timeEntries   TimeEntry[]
  approvals     Approval[]         @relation("Approver")
  assignedTasks Task[]             @relation("Assignee")
  createdCases  Case[]             @relation("Creator")
  notifications Notification[]

  @@index([email])
  @@index([role])
}

model LawFirm {
  id                  String   @id @default(uuid())
  name                String
  taxNumber           String   @unique
  address             String
  phone               String
  email               String
  barAssociation      String
  settings            Json     @default("{}") // firm-specific settings
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  cases               Case[]
  lawyers             User[]
  clients             Client[]
  templates           Template[]
  billingRates        BillingRate[]
  trustAccounts       TrustAccount[]
}

model Client {
  id              String   @id @default(uuid())
  lawFirmId       String
  lawFirm         LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  name            String
  type            String   // "individual", "corporate"
  taxId           String?  @unique // TCKN or VKN
  email           String?
  phone           String?
  address         String?
  sensitivityLevel SensitivityLevel @default(L1_NORMAL)
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cases           Case[]
  parties         Party[]
  documents       Document[]
  invoices        Invoice[]
  trustAccount    TrustAccount?

  @@index([lawFirmId])
  @@index([taxId])
  @@index([sensitivityLevel])
}

model Case {
  id              String      @id @default(uuid())
  lawFirmId       String
  lawFirm         LawFirm     @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creatorId       String
  creator         User        @relation("Creator", fields: [creatorId], references: [id])
  caseNumber      String
  courtName       String?
  caseType        CaseType
  status          CaseStatus  @default(OPEN)
  description     String?
  sensitivityLevel SensitivityLevel @default(L1_NORMAL)
  metadata        Json        @default("{}")
  openedAt        DateTime    @default(now())
  closedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  lawyers         CaseLawyer[]
  parties         Party[]
  documents       Document[]
  hearings        Hearing[]
  deadlines       Deadline[]
  timeEntries     TimeEntry[]
  invoices        Invoice[]
  researchMemos   ResearchMemo[]
  petitions       Petition[]

  @@unique([lawFirmId, caseNumber])
  @@index([lawFirmId])
  @@index([clientId])
  @@index([status])
  @@index([caseType])
}

model CaseLawyer {
  id        String @id @default(uuid())
  caseId    String
  case      Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // "lead", "assisting", "supervising"
  assignedAt DateTime @default(now())

  @@unique([caseId, userId])
  @@index([caseId])
  @@index([userId])
}

model Party {
  id          String      @id @default(uuid())
  caseId      String
  case        Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name        String
  role        PartyRole
  taxId       String?     // TCKN/VKN for conflict check
  email       String?
  phone       String?
  address     String?
  isOpposing  Boolean     @default(false)
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([caseId])
  @@index([taxId])
  @@index([role])
}

// ============================================
// DOCUMENTS & ARCHIVE
// ============================================

model Document {
  id                 String           @id @default(uuid())
  caseId             String
  case               Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  clientId           String?
  client             Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lawFirmId          String
  lawFirm            LawFirm          @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  title              String
  type               DocumentType
  content            String?          // OCR extracted text
  contentHash        String           @unique // SHA256 for deduplication
  filePath           String?          // Nextcloud path
  fileSize           Int?
  mimeType           String?
  sensitivityLevel   SensitivityLevel @default(L1_NORMAL)
  pseudonymMap       Json?            // L2: mapping of pseudonyms to real values
  embedding          Unsupported("vector(1024)")? // bge-m3 embedding
  pgTrgmVector       Unsupported("tsvector")?     // for full-text search
  metadata           Json             @default("{}")
  uploadedById       String
  uploadedBy         User             @relation(fields: [uploadedById], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  petitionRefs       PetitionDocument[]
  researchRefs       ResearchDocument[]

  @@index([caseId])
  @@index([clientId])
  @@index([lawFirmId])
  @@index([type])
  @@index([sensitivityLevel])
  @@index([contentHash])
}

model Template {
  id            String   @id @default(uuid())
  lawFirmId     String
  lawFirm       LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  name          String
  type          DocumentType
  content       String   // docxtpl template
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([lawFirmId])
  @@index([type])
}

// ============================================
// HEARINGS & DEADLINES (Süreler & Duruşma)
// ============================================

model Hearing {
  id            String   @id @default(uuid())
  caseId        String
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  courtName     String
  hearingDate   DateTime
  hearingType   String   // "first", "interim", "final", "expert"
  notes         String?
  isVirtual     Boolean  @default(false)
  meetingLink   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([caseId])
  @@index([hearingDate])
}

model Deadline {
  id              String   @id @default(uuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  dueDate         DateTime
  calculatedDate  DateTime // HMK hesaplamalı tarih
  basis           String   // "HMK m.104", "resmi tatil", etc.
  isCritical      Boolean  @default(false)
  status          TaskStatus @default(PENDING)
  completedAt     DateTime?
  reminderSent    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([caseId])
  @@index([dueDate])
  @@index([status])
  @@index([isCritical])
}

// ============================================
// TIME TRACKING & BILLING
// ============================================

model TimeEntry {
  id            String      @id @default(uuid())
  caseId        String
  case          Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  durationMinutes Int
  description   String
  activityType  String      // "meeting", "drafting", "research", "court", "phone", "email"
  isBillable    Boolean     @default(true)
  hourlyRate    Decimal?    @db.Decimal(10, 2)
  status        TaskStatus  @default(PENDING) // draft -> submitted -> approved
  source        String?     // "manual", "email", "calendar", "document", "phone"
  sourceRef     String?     // reference to source (email id, doc id, etc.)
  metadata      Json        @default("{}")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  approvedAt    DateTime?
  approvedById  String?
  approvedBy    User?       @relation("Approver", fields: [approvedById], references: [id])

  @@index([caseId])
  @@index([userId])
  @@index([date])
  @@index([status])
}

model BillingRate {
  id          String   @id @default(uuid())
  lawFirmId   String
  lawFirm     LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  caseType    CaseType?
  role        String?  // "partner", "senior", "junior", "intern"
  hourlyRate  Decimal  @db.Decimal(10, 2)
  currency    String   @default("TRY")
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lawFirmId])
  @@index([userId])
}

model Invoice {
  id              String      @id @default(uuid())
  lawFirmId       String
  lawFirm         LawFirm     @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  caseId          String?
  case            Case?       @relation(fields: [caseId], references: [id], onDelete: SetNull)
  clientId        String
  client          Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceNumber   String
  type            BillingType
  status          String      @default("draft") // draft, sent, paid, overdue, cancelled
  subtotal        Decimal     @db.Decimal(12, 2)
  taxAmount       Decimal     @db.Decimal(12, 2)
  totalAmount     Decimal     @db.Decimal(12, 2)
  currency        String      @default("TRY")
  issueDate       DateTime
  dueDate         DateTime
  paidDate        DateTime?
  eInvoiceId      String?     // e-SMM / GIB entegrasyon ID
  metadata        Json        @default("{}")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           InvoiceItem[]
  trustTransfers  TrustTransfer[]

  @@unique([lawFirmId, invoiceNumber])
  @@index([lawFirmId])
  @@index([clientId])
  @@index([caseId])
  @@index([status])
  @@index([issueDate])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
  timeEntryId String?
  sortOrder   Int      @default(0)

  @@index([invoiceId])
}

model TrustAccount {
  id          String   @id @default(uuid())
  lawFirmId   String
  lawFirm     LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  balance     Decimal  @default(0) @db.Decimal(12, 2)
  currency    String   @default("TRY")
  iban        String?
  bankName    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transfers   TrustTransfer[]

  @@unique([lawFirmId, clientId])
  @@index([lawFirmId])
  @@index([clientId])
}

model TrustTransfer {
  id            String       @id @default(uuid())
  trustAccountId String
  trustAccount  TrustAccount @relation(fields: [trustAccountId], references: [id], onDelete: Cascade)
  invoiceId     String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount        Decimal      @db.Decimal(12, 2)
  type          String       // "deposit", "withdrawal", "fee_payment", "expense"
  description   String
  reference     String?
  createdAt     DateTime     @default(now())

  @@index([trustAccountId])
  @@index([invoiceId])
}

// ============================================
// RESEARCH & PETITIONS
// ============================================

model ResearchMemo {
  id            String   @id @default(uuid())
  caseId        String
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title         String
  question      String
  answer        String
  citations     Json     @default("[]") // array of {court, decisionNumber, date, url, excerpt}
  modelUsed     String   // "opus-5.5", "sonnet-5.5"
  confidence    Float    @default(0)
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  documents     ResearchDocument[]

  @@index([caseId])
  @@index([createdById])
}

model ResearchDocument {
  id               String @id @default(uuid())
  researchMemoId   String
  researchMemo     ResearchMemo @relation(fields: [researchMemoId], references: [id], onDelete: Cascade)
  documentId       String
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  relevanceScore   Float
  excerpt          String?

  @@unique([researchMemoId, documentId])
  @@index([researchMemoId])
  @@index([documentId])
}

model Petition {
  id              String         @id @default(uuid())
  caseId          String
  case            Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  templateId      String?
  template        Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  title           String
  content         String         // generated docx content (base64 or path)
  status          ApprovalStatus @default(PENDING)
  modelUsed       String         // "opus-5.5-high"
  generatedAt     DateTime       @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?          @relation(fields: [reviewedById], references: [id])
  filedAt         DateTime?
  uyapReceiptNo   String?
  metadata        Json           @default("{}")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  documents       PetitionDocument[]

  @@index([caseId])
  @@index([status])
  @@index([templateId])
}

model PetitionDocument {
  id          String   @id @default(uuid())
  petitionId  String
  petition    Petition @relation(fields: [petitionId], references: [id], onDelete: Cascade)
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  role        String   // "evidence", "reference", "attachment"

  @@unique([petitionId, documentId])
  @@index([petitionId])
  @@index([documentId])
}

// ============================================
// CONFLICT CHECK & COMPLIANCE
// ============================================

model ConflictCheck {
  id              String               @id @default(uuid())
  caseId          String?
  case            Case?                @relation(fields: [caseId], references: [id], onDelete: SetNull)
  checkedTaxIds   String[]             // TCKN/VKN listesi
  checkedNames    String[]             // isim listesi
  status          ConflictCheckStatus
  matches         Json                 @default("[]") // {partyId, matchType, confidence}
  checkedAt       DateTime             @default(now())
  checkedById     String
  checkedBy       User                 @relation(fields: [checkedById], references: [id])
  notes           String?

  @@index([caseId])
  @@index([status])
  @@index([checkedAt])
}

// ============================================
// APPROVAL WORKFLOW
// ============================================

model Approval {
  id              String         @id @default(uuid())
  type            String         // "petition", "invoice", "time_entry", "email", "contract"
  resourceId      String         // ID of the resource being approved
  resourceType    String         // "Petition", "Invoice", "TimeEntry", "EmailDraft"
  title           String
  description     String?
  status          ApprovalStatus @default(PENDING)
  requestedById   String
  requestedBy     User           @relation(fields: [requestedById], references: [id])
  approverId      String?
  approver        User?          @relation("Approver", fields: [approverId], references: [id])
  requestedAt     DateTime       @default(now())
  respondedAt     DateTime?
  comments        String?
  metadata        Json           @default("{}")

  @@index([resourceId, resourceType])
  @@index([status])
  @@index([approverId])
  @@index([requestedById])
}

// ============================================
// NOTIFICATIONS & AUDIT
// ============================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "hearing_reminder", "deadline_alert", "approval_request", "daily_briefing"
  title     String
  message   String
  priority  String   @default("normal") // low, normal, high, critical
  isRead    Boolean  @default(false)
  readAt    DateTime?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // "create", "read", "update", "delete", "export", "ai_call"
  resourceType String  // "Case", "Document", "Petition", etc.
  resourceId  String?
  details     Json     @default("{}")
  ipAddress   String?
  userAgent   String?
  hash        String   // hash chain for immutability
  prevHash    String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@index([action])
}

// ============================================
// AI INTERACTIONS (for cost tracking & audit)
// ============================================

model AIInteraction {
  id              String   @id @default(uuid())
  caseId          String?
  case            Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  department      String   // "intake", "conflict", "deadlines", "research", "petition", "email", "time", "billing"
  model           String   // "haiku-5.5", "sonnet-5.5", "opus-5.5"
  effort          String   // "low", "medium", "high"
  promptTokens    Int
  completionTokens Int
  totalTokens     Int
  estimatedCost   Decimal  @db.Decimal(10, 6)
  promptHash      String   // hash of prompt for deduplication
  responseHash    String
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())

  @@index([caseId])
  @@index([department])
  @@index([model])
  @@index([createdAt])
}

// ============================================
// DAILY BRIEFING
// ============================================

model DailyBriefing {
  id          String   @id @default(uuid())
  lawFirmId   String
  lawFirm     LawFirm  @relation(fields: [lawFirmId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  content     Json     @default("{}") // structured briefing data
  generatedAt DateTime @default(now())
  sentAt      DateTime?
  recipients  String[] // user IDs

  @@unique([lawFirmId, date])
  @@index([lawFirmId])
  @@index([date])
}